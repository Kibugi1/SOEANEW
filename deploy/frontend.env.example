# Settings for building and running the website on the VPS.
# On the VPS:  /srv/soeaweb/frontend.env   (deploy.sh copies it in before each build).

# Where browsers reach the API. Baked into the site when it is built, so rebuild
# (deploy.sh) after changing it.
NEXT_PUBLIC_API_BASE_URL=https://api.sq1ecoafrica.org/api/v1

# Where the website's own server fetches programs and stories. Talking to the API
# directly on the VPS is faster than going out through the internet and back.
CONTENT_API_BASE_URL=http://127.0.0.1:8020/api/v1
