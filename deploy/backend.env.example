# Production settings for the SOEA API.
# On the VPS:  /srv/soeaweb/backend.env   (owner soeaweb, chmod 600). Never commit real values.

APP_ENV=production

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The soeaweb PostgreSQL user and database from DEPLOY.md step 2.
# Percent-encode special characters in the password: '#' -> %23, '@' -> %40, '/' -> %2F.
DATABASE_URL=postgresql+psycopg://soeaweb:DB_PASSWORD@127.0.0.1:5432/soeaweb

# Redis on the VPS keeps the per-visitor form limits (DEPLOY.md step 1). DB 1 keeps it
# apart from anything else that uses Redis.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# nginx sits in front of the API, so trust one X-Forwarded-For hop.
PROXY_COUNT=1

# Exact HTTPS origins of the website (no trailing slash). Keep the staging address while
# you test on new.sq1ecoafrica.org; remove it after the switch-over if you like.
CORS_ORIGINS=https://sq1ecoafrica.org,https://www.sq1ecoafrica.org,https://new.sq1ecoafrica.org

# Public addresses
API_PUBLIC_URL=https://api.sq1ecoafrica.org/api/v1
ADMIN_DASHBOARD_URL=https://sq1ecoafrica.org/admin
NEWSLETTER_CONFIRMATION_URL=https://sq1ecoafrica.org/confirm-subscription
NEWSLETTER_UNSUBSCRIBE_URL=https://sq1ecoafrica.org/unsubscribe

# Uploaded photos and documents (the API serves them under /media).
UPLOAD_DIR=/srv/soeaweb/uploads
MEDIA_BASE_URL=https://api.sq1ecoafrica.org/media

# Email: Google Workspace, signed in as info@ with an app password (same as backend/.env).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@sq1ecoafrica.org
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@sq1ecoafrica.org

# Inboxes alerted when a website message arrives.
INBOX_PARTNERSHIPS_EMAIL=partnerships@sq1ecoafrica.org
INBOX_VOLUNTEERS_EMAIL=career@sq1ecoafrica.org
INBOX_INFO_EMAIL=info@sq1ecoafrica.org

NEWSLETTER_CONSENT_TEXT_VERSION=v1
