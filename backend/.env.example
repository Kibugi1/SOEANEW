# Copy to .env (never commit .env).
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
SECRET_KEY=replace-with-a-local-random-secret

# PostgreSQL is required for migrations. Once the database exists, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://soea_dev:local_password@localhost:5432/soea_dev

# Comma-separated exact origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000

# ============================================================
# PRODUCTION DEPLOYMENT EXAMPLE
# Uncomment and replace placeholders in your deployment
# provider's environment settings. Never commit real secrets.
# ============================================================

# APP_ENV=production
# SECRET_KEY=generate-a-unique-random-secret-of-at-least-32-characters
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# RATELIMIT_STORAGE_URI=rediss://USER:PASSWORD@REDIS-HOST:6379/0

# Exact HTTPS origin of the deployed frontend; no trailing slash.
# CORS_ORIGINS=https://your-frontend-domain.example

# SMTP settings for newsletter confirmation and campaign delivery.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=newsletters@your-domain.example

# Full frontend pages that receive confirmation/unsubscribe tokens.
# NEWSLETTER_CONFIRMATION_URL=https://your-frontend-domain.example/confirm-subscription
# NEWSLETTER_UNSUBSCRIBE_URL=https://your-frontend-domain.example/unsubscribe

# Update this whenever the newsletter consent wording changes.
# NEWSLETTER_CONSENT_TEXT_VERSION=v1

# Inboxes that are emailed when a website message arrives (the message itself stays in
# the admin inbox; the email only links to it). Leave one empty to skip that alert.
INBOX_PARTNERSHIPS_EMAIL=partnerships@sq1ecoafrica.org
INBOX_VOLUNTEERS_EMAIL=career@sq1ecoafrica.org
INBOX_INFO_EMAIL=info@sq1ecoafrica.org

# Admin dashboard base URL, used for links in notification emails.
# ADMIN_DASHBOARD_URL=https://your-frontend-domain.example/admin

# Uploaded images and documents. Defaults to backend/instance/uploads (git-ignored).
# In production, serve this folder from the web server or a CDN and point
# MEDIA_BASE_URL at it.
# UPLOAD_DIR=/var/lib/soea/uploads
# MEDIA_BASE_URL=https://api.your-domain.example/media
